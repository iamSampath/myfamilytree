# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app config.
# These identify your Firebase project; they are not secret passwords. Access is enforced by the Firestore security rules in the Firebase console.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional: set to "true" to use local emulators (npx firebase emulators:start)
NEXT_PUBLIC_USE_EMULATORS=
# Optional: reCAPTCHA v3 site key to turn on Firebase App Check.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

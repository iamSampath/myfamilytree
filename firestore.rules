rules_version = '2';

// Data model
//   users/{uid}/trees/{treeId}            -> the signed-in user's list of trees (their own index)
//   trees/{treeId}                        -> { name, ownerId, createdAt }
//   trees/{treeId}/members/{uid}          -> { uid, role: owner|editor|viewer, name, email, joinedAt, inviteId? }
//   trees/{treeId}/invites/{inviteId}     -> { treeName, role: editor|viewer, createdBy, createdAt, revoked }
//   trees/{treeId}/people/{personId}
//   trees/{treeId}/families/{familyId}
//   trees/{treeId}/history/{entryId}      -> append-only change log
//
// Nobody can read a tree unless they are a member. Only owners and editors change people
// and families. Joining requires being signed in AND holding a valid invite id.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function memberPath(treeId, uid) { return /databases/$(database)/documents/trees/$(treeId)/members/$(uid); }
    function isMember(treeId) { return signedIn() && exists(memberPath(treeId, request.auth.uid)); }
    function roleIn(treeId) { return get(memberPath(treeId, request.auth.uid)).data.role; }
    function canEdit(treeId) { return isMember(treeId) && roleIn(treeId) in ['owner', 'editor']; }
    function isOwner(treeId) { return isMember(treeId) && roleIn(treeId) == 'owner'; }
    function shortStr(v, max) { return v is string && v.size() <= max; }
    function onlyKeys(d, keys) { return d.keys().hasOnly(keys); }

    match /users/{uid}/trees/{treeId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /trees/{treeId} {
      allow read: if isMember(treeId);
      allow create: if signedIn()
        && onlyKeys(request.resource.data, ['name', 'ownerId', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && shortStr(request.resource.data.name, 120)
        // The owner's member record must be written in the same batch.
        && getAfter(memberPath(treeId, request.auth.uid)).data.role == 'owner';
      allow update: if isOwner(treeId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && shortStr(request.resource.data.name, 120);
      allow delete: if isOwner(treeId);

      match /members/{uid} {
        allow read: if isMember(treeId);

        // 1) The creator becomes owner in the same batch that creates the tree.
        // 2) Anyone signed in joins with the role written on a valid invite.
        allow create: if signedIn() && uid == request.auth.uid
          && onlyKeys(request.resource.data, ['uid', 'role', 'name', 'email', 'joinedAt', 'inviteId'])
          && request.resource.data.uid == uid
          && shortStr(request.resource.data.name, 120)
          && shortStr(request.resource.data.email, 200)
          && (
            (request.resource.data.role == 'owner'
              && !exists(/databases/$(database)/documents/trees/$(treeId))
              && getAfter(/databases/$(database)/documents/trees/$(treeId)).data.ownerId == request.auth.uid)
            ||
            (request.resource.data.inviteId is string
              && exists(/databases/$(database)/documents/trees/$(treeId)/invites/$(request.resource.data.inviteId))
              && get(/databases/$(database)/documents/trees/$(treeId)/invites/$(request.resource.data.inviteId)).data.revoked == false
              && get(/databases/$(database)/documents/trees/$(treeId)/invites/$(request.resource.data.inviteId)).data.role == request.resource.data.role)
          );

        // Owners change other members' roles (never to owner) ...
        allow update: if isOwner(treeId) && uid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['editor', 'viewer'];
        // ... and remove them. Non-owners may leave a tree.
        allow delete: if (isOwner(treeId) && uid != request.auth.uid)
          || (isMember(treeId) && uid == request.auth.uid && roleIn(treeId) != 'owner');
      }

      match /invites/{inviteId} {
        // Invite ids are long random strings; a signed-in person holding the link can read
        // that one invite (to see the tree name and role) but cannot list invites.
        allow get: if signedIn();
        allow list: if isOwner(treeId);
        allow create: if isOwner(treeId)
          && onlyKeys(request.resource.data, ['treeName', 'role', 'createdBy', 'createdAt', 'revoked'])
          && inviteId.size() >= 20
          && request.resource.data.role in ['editor', 'viewer']
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.revoked == false
          && shortStr(request.resource.data.treeName, 120);
        allow update: if isOwner(treeId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked']);
        allow delete: if isOwner(treeId);
      }

      match /people/{personId} {
        allow read: if isMember(treeId);
        allow create, update: if canEdit(treeId)
          && onlyKeys(request.resource.data, ['name', 'sex', 'family', 'fatherId', 'motherId', 'spouseId', 'private', 'placeholder'])
          && shortStr(request.resource.data.name, 200) && request.resource.data.name.size() > 0
          && request.resource.data.sex in ['M', 'F', '']
          && shortStr(request.resource.data.family, 200)
          && shortStr(request.resource.data.fatherId, 200)
          && shortStr(request.resource.data.motherId, 200)
          && shortStr(request.resource.data.spouseId, 200)
          && request.resource.data.private is bool;
        allow delete: if canEdit(treeId);
      }

      match /families/{familyId} {
        allow read: if isMember(treeId);
        allow create, update: if canEdit(treeId)
          && onlyKeys(request.resource.data, ['surname', 'gothram'])
          && shortStr(request.resource.data.surname, 120) && request.resource.data.surname.size() > 0
          && shortStr(request.resource.data.gothram, 120);
        allow delete: if canEdit(treeId);
      }

      match /history/{entryId} {
        allow read: if isMember(treeId);
        allow create: if canEdit(treeId)
          && request.resource.data.by == request.auth.uid
          && request.resource.data.coll in ['people', 'families']
          && shortStr(request.resource.data.label, 300);
        allow update, delete: if false;
      }
    }
  }
}
